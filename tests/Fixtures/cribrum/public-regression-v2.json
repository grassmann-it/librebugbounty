      },
      "expectedPresent": [
        "sql_error_observed",
        "sql_input_structure_indication"
      ],
      "expectedAttributes": {
        "sql_error_observed": {
          "vendor": "unknown"
        },
        "sql_input_structure_indication": {
          "parameter": "category",
          "assessment": "suspected_only"
        }
      },
      "expectedAbsent": [
        "execution_observed"
      ],
      "reason": "Full local input supports suspicion, while generic Yii SQLSTATE does not identify the database vendor."
    },
    {
      "id": "r13-prefixless-fixed-include",
      "input": {
        "url": "https://fixture.invalid/?q=ordinary",
