{
  "fixtureVersion": 2,
  "description": "Public synthetic semantic specification. No real finding/cohort membership; expectations require independent implementation tests.",
  "cases": [
    {
      "id": "complete-xss",
      "given": "XSS execution basis; complete current profile; no extra hint",
      "expected": {
        "kind": "pure_xss",
        "purity": "pure",
        "coverageStatus": "complete",
        "pureXssScope": true,
        "xssContainingScope": true
      }
    },
    {
      "id": "xss-sql-structure",
      "given": "XSS and qualified SQL structural suspicion",
      "expected": {
        "kind": "mixed",
        "purity": "mixed",
        "coverageStatus": "complete",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "xss-sql-error",
      "given": "XSS and SQL error without structural suspicion",
      "expected": {
        "kind": "mixed",
        "purity": "mixed",
        "coverageStatus": "complete",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "e2-unknown-coverage",
      "given": "Explicit fixed E2 membership matching baseline; unknown coverage",
      "expected": {
        "kind": "xss",
        "purity": "unknown",
        "coverageStatus": "unknown",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "sql-only-coverage",
      "given": "XSS basis with only SQL family evaluated",
      "expected": {
        "kind": "xss",
        "purity": "unknown",
        "coverageStatus": "partial",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "stale-coverage",
      "given": "XSS basis but coverage references another PoC/artifact",
      "expected": {
        "kind": "xss",
        "purity": "unknown",
        "coverageStatus": "unknown",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "pure-disclosure",
      "given": "Concrete internal path, complete current profile; no unrelated hint",
      "expected": {
        "kind": "pure_information_disclosure",
        "purity": "pure",
        "coverageStatus": "complete",
        "pureXssScope": false,
        "xssContainingScope": false
      }
    },
    {
      "id": "unknown-signal",
      "given": "XSS basis and unrecognized active fact",
      "expected": {
        "kind": "xss",
        "purity": "unknown",
        "coverageStatus": "unknown",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    },
    {
      "id": "new-waf-block",
      "given": "XSS basis and new relevant block pending explicit acknowledgement",
      "expected": {
        "kind": "xss",
        "purity": "unknown",
        "coverageStatus": "complete",
        "pureXssScope": false,
        "xssContainingScope": true
      }
    }
  ],
  "detectorCases": [
    {
      "id": "positive-local-sql",
      "input": {
        "url": "https://fixture.invalid/search?q=%27probe",
        "rawHtml": "Microsoft JET Database Engine error '80040e14'\nSyntax error (missing operator) in query expression 'name = ''probe'."
      },
      "expectedPresent": [
        "sql_error_observed"
      ],
      "expectedAbsent": [
        "execution_observed"
      ],
      "reason": "A real diagnostic signature does not by itself prove execution or sufficient input structure mapping."
    },
    {
      "id": "negative-documentation",
      "input": {
        "url": "https://fixture.invalid/docs",
        "rawHtml": "<article>Example: SQLSTATE errors can occur in a tutorial.</article>"
      },
      "expectedAbsent": [
        "sql_input_structure_indication",
        "execution_observed"
      ],
      "reason": "Documentation and tokens are not qualified structural or execution proof."
    },
    {
      "id": "negative-unrelated-reflection",
      "input": {
        "url": "https://fixture.invalid/search?q=probe",
        "rawHtml": "<p>probe</p><div>Generic DateTime conversion failed.</div>"
      },
      "expectedAbsent": [
        "input_in_sql_error",
        "sql_input_structure_indication"
      ],
      "reason": "Page-wide coexistence cannot establish same-block SQL association."
    },
    {
      "id": "negative-include-success",
      "input": {
        "url": "https://fixture.invalid/view?file=demo",
        "rawHtml": "MapPath rejected the supplied path."
      },
      "expectedAbsent": [
        "sensitive_file_content_observed",
        "execution_observed"
      ],
      "reason": "Path rejection does not prove file disclosure or code execution."
    },
    {
      "id": "r13-link-tail-is-not-sql-operand",
      "input": {
        "url": "https://fixture.invalid/?inc=%27%3E%3Ctest%20alt%3D%22%22%3E-marker&typ=Nav2&cat=140",
        "rawHtml": "<p>Syntax error (missing operator) in query expression &#039;Active = 1 AND Link = &#039;&#039;&gt;&lt;test alt=[]&gt;-marker&amp;typ=Nav2&amp;cat=140&#039;&#039;.</p>"
      },
      "expectedPresent": [
        "sql_error_observed"
      ],
      "expectedAbsent": [
        "sql_input_structure_indication"
      ],
      "reason": "A plain link key after changed input does not become a SQL operand."
    },
    {
      "id": "r13-yii-local-full-operand",
      "input": {
        "url": "https://fixture.invalid/?category=%27%3Eprobe",
